PORT=3000
STORAGE_DRIVER=firestore
FIRESTORE_DATABASE_ID=(default)
DATABASE_PATH=./data/noteflow.sqlite
# To opt into Neon PostgreSQL, set STORAGE_DRIVER=postgres and put the server-only
# Neon connection string in DATABASE_URL. Never use a VITE_ prefix.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase project ID used to verify Firebase Authentication ID tokens.
FIREBASE_PROJECT_ID=noteflowai-73991

# Choose one server-only credential method:
# 1. Set FIREBASE_SERVICE_ACCOUNT_JSON to the full service-account JSON (keep it secret).
FIREBASE_SERVICE_ACCOUNT_JSON=
# 2. Or set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=
# For local emulators only; do not set these in production.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# Server-only Gemini API key from Google AI Studio. Never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Daily cap for total authenticated AI requests across the service.
AI_GLOBAL_DAILY_REQUEST_LIMIT=10000
# Caps generated response size for Gemini chat and note-AI requests.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Stripe recurring billing. Never expose these secrets to Vite.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_TEAM=
BILLING_APP_URL=http://localhost:5173
